# Copy to .env and customise. .env is git-ignored.

# Postgres
POSTGRES_USER=findadoc
POSTGRES_PASSWORD=findadoc
POSTGRES_DB=findadoc
POSTGRES_PORT=5432

# Application ports
API_PORT=8080
WEB_PORT=3000

# Public URL the browser uses to reach the API.
# In dev: http://localhost:8080
# In production: https://api.your-domain.tld
PUBLIC_API_URL=http://localhost:8080
