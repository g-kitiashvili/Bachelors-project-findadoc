# Copy to .env and customise. .env is git-ignored.

# Postgres
POSTGRES_USER=findadoc
POSTGRES_PASSWORD=findadoc
POSTGRES_DB=findadoc
POSTGRES_PORT=5432

# Application ports
API_PORT=8080
WEB_PORT=3000

# URL the web server uses for its server-side (SSR) fetches to the API.
# In dev: http://localhost:8080
# In docker-compose: http://api:8080
API_URL=http://localhost:8080
